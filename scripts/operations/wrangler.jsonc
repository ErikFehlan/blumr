{
  "name": "blumr-operations",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {"enabled": true},
  "triggers": {"crons": ["*/5 * * * *"]},
  "durable_objects": {"bindings": [{"name": "MONITOR", "class_name": "MonitorState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["MonitorState"]}]
}
